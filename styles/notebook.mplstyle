# Ticks
xtick.top : True
xtick.bottom : True
xtick.direction : in

ytick.left : True
ytick.right : True
ytick.direction : in

# Axes
axes.spines.top : True
axes.spines.right : True

# Grid
axes.grid : True
grid.linestyle : -
grid.color : gray
grid.alpha : 0.15

# Fonts
font.size : 11
axes.labelsize : 12
axes.titlesize : 13

xtick.labelsize : 10
ytick.labelsize : 10

legend.fontsize : 10

# Figure
figure.figsize : 9, 5
figure.dpi : 120

# Lines
lines.linewidth : 2

# Save
savefig.bbox : tight
savefig.dpi : 300